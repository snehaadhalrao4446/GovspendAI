{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/secure-gateway/auth/login", "destination": "/api/auth/login" },
    { "source": "/secure-gateway/(.*)", "destination": "/api/$1" }
  ]
}
